"use client";

import * as React from "react";
import { Check, Loader2, Search, UserRoundCheck } from "lucide-react";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
    const load = React.useCallback(() => {
      fetch(`/api/admin/users?q=${encodeURIComponent(query)}`)
        .then((response) => response.json())
        .then((body) => setUsers(body.users ?? []));
    }, [query]);
import { Select } from "@/components/ui/select";

interface ManagedUser { id: string; display_name: string; email: string; department: string; job_title: string; account_status: string; roles: Array<{ role: string }>; }

export function UserManagementPanel() {
  const [query, setQuery] = React.useState("");
  const [users, setUsers] = React.useState<ManagedUser[]>([]);
  const [message, setMessage] = React.useState("");
  const [savingUser, setSavingUser] = React.useState<string | null>(null);
  const [roleFilter, setRoleFilter] = React.useState("All roles");
  const load = React.useCallback(() => { fetch(`/api/admin/users?q=${encodeURIComponent(query)}`).then((response) => response.json()).then((body) => setUsers(body.users ?? [])); }, [query]);
  React.useEffect(() => { load(); }, [load]);
  const visibleUsers = users.filter((user) => roleFilter === "All roles" || (user.roles[0]?.role ?? "User") === roleFilter);
  const update = async (userId: string, field: string, value: string) => { setSavingUser(userId); setMessage(""); const response = await fetch("/api/admin/users", { method: "PATCH", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ userId, [field]: value }) }); const body = await response.json(); setMessage(response.ok ? "Changes saved successfully." : body.error ?? "Unable to update user"); setSavingUser(null); if (response.ok) load(); };
  return <Card className="mb-6"><CardHeader><CardTitle className="flex items-center gap-2"><UserRoundCheck className="h-4 w-4 text-primary" />User access management</CardTitle><p className="text-sm text-muted-foreground">Search the directory and update one user at a time without leaving this page.</p></CardHeader><CardContent><div className="mb-4 grid gap-3 sm:grid-cols-[minmax(0,1fr)_180px]"><div className="relative"><Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" /><Input value={query} onChange={(event) => setQuery(event.target.value)} className="pl-9" placeholder="Search name, email or department" /></div><Select value={roleFilter} onChange={(event) => setRoleFilter(event.target.value)}><option>All roles</option><option>User</option><option>Approver</option><option>Manager</option><option>Admin</option><option>Super Admin</option></Select></div><div className="mb-2 flex items-center justify-between text-xs text-muted-foreground"><span>{visibleUsers.length} users shown</span><span>Showing up to 5 at a time</span></div><div className="max-h-[27rem] overflow-y-auto rounded-lg border border-border"><div className="overflow-x-auto"><table className="w-full min-w-[760px] text-left text-sm"><thead className="sticky top-0 z-10 border-b border-border bg-muted text-xs uppercase text-muted-foreground"><tr><th className="px-3 py-2">User</th><th className="px-3 py-2">Department</th><th className="px-3 py-2">Role</th><th className="px-3 py-2">Status</th></tr></thead><tbody className="divide-y divide-border">{visibleUsers.slice(0, 5).map((user) => <tr key={user.id}><td className="px-3 py-3"><p className="font-medium">{user.display_name}</p><p className="text-xs text-muted-foreground">{user.email} · {user.job_title || "No title"}</p></td><td className="px-3 py-3"><Input defaultValue={user.department} onBlur={(event) => { if (event.target.value !== user.department) update(user.id, "department", event.target.value); }} /></td><td className="px-3 py-3"><Select value={user.roles[0]?.role ?? "User"} onChange={(event) => update(user.id, "role", event.target.value)}><option>User</option><option>Approver</option><option>Manager</option><option>Admin</option><option>Super Admin</option></Select></td><td className="px-3 py-3"><Button variant="ghost" size="sm" disabled={savingUser === user.id} onClick={() => update(user.id, "status", user.account_status === "active" ? "inactive" : "active")}>{savingUser === user.id ? <Loader2 className="h-4 w-4 animate-spin" /> : <Badge variant={user.account_status === "active" ? "success" : "neutral"}>{user.account_status === "active" ? "Active" : "Inactive"}</Badge>}</Button></td></tr>)}</tbody></table></div>{visibleUsers.length > 5 && <p className="border-t border-border bg-muted/40 px-3 py-2 text-center text-xs text-muted-foreground">Refine your search to see more users.</p>}</div>{!visibleUsers.length && <p className="py-8 text-center text-sm text-muted-foreground">No synchronized users found.</p>}{message && <p className="mt-3 flex items-center gap-1.5 rounded-md border border-success/20 bg-success/5 px-3 py-2 text-sm text-success"><Check className="h-4 w-4" />{message}</p>}</CardContent></Card>;
}
