import { NextResponse } from "next/server";
import { getSessionUser, isAdminEmail } from "@/lib/session";
import { simulateApprovalPolicy } from "@/lib/services/administration";

export const dynamic = "force-dynamic";

export async function POST(request: Request) {
  const user = await getSessionUser();
  if (!user || !(await isAdminEmail(user.email))) return NextResponse.json({ error: "Forbidden" }, { status: 403 });
  let body: { requestType?: unknown; departmentCode?: unknown; priority?: unknown };
  try { body = await request.json(); } catch { return NextResponse.json({ error: "Invalid body" }, { status: 400 }); }
  if (typeof body.requestType !== "string") return NextResponse.json({ error: "requestType is required" }, { status: 400 });
  return NextResponse.json(await simulateApprovalPolicy({ requestType: body.requestType, departmentCode: typeof body.departmentCode === "string" ? body.departmentCode : undefined, priority: typeof body.priority === "string" ? body.priority : undefined }));
}
