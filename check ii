"use client";

import * as React from "react";
import { Plus, RefreshCw } from "lucide-react";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";

type Resource = "form" | "workflow" | "notification" | "report" | "setting" | "feature";
type Item = { id?: string; name?: string; form_key?: string; workflow_key?: string; event_key?: string; report_key?: string; setting_key?: string; flag_key?: string; status?: string; enabled?: boolean; definition?: unknown };

const RESOURCE_COPY: Record<Resource, { title: string; key: string; name: string }> = {
  form: { title: "Database-backed request forms", key: "Form key", name: "Form name" },
  workflow: { title: "Workflow definitions", key: "Workflow key", name: "Workflow name" },
  notification: { title: "Notification events", key: "Event key", name: "Event name" },
  report: { title: "Saved reports", key: "Report key", name: "Report name" },
  setting: { title: "Portal settings", key: "Setting key", name: "Value" },
  feature: { title: "Feature flags", key: "Flag key", name: "Description" },
};

export function MetadataManager({ resource }: { resource: Resource }) {
  const copy = RESOURCE_COPY[resource];
  const [items, setItems] = React.useState<Item[]>([]);
  const [key, setKey] = React.useState("");
  const [name, setName] = React.useState("");
  const [definition, setDefinition] = React.useState("{}");
  const [message, setMessage] = React.useState("");

  const load = React.useCallback(() => {
    fetch("/api/admin/metadata").then((response) => response.json()).then((body) => {
      const map: Record<Resource, Item[] | undefined> = { form: body.forms, workflow: body.workflows, notification: body.notifications, report: body.reports, setting: body.settings, feature: body.flags };
      setItems(map[resource] ?? []);
    });
  }, [resource]);

  React.useEffect(() => { load(); }, [load]);

  const save = async () => {
    setMessage("");
    let parsed: unknown = {};
    try { parsed = JSON.parse(definition || "{}"); } catch { setMessage("Definition must be valid JSON."); return; }
    const body = resource === "setting" ? { resource, key, value: parsed } : resource === "feature" ? { resource, key, enabled: true, description: name } : { resource, key, name, definition: parsed, ...(resource === "notification" ? { channels: ["in-app", "email"], template: parsed } : {}) };
    const response = await fetch("/api/admin/metadata", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
    const result = await response.json();
    if (!response.ok) { setMessage(result.error ?? "Unable to save definition"); return; }
    setKey(""); setName(""); setDefinition("{}"); setMessage("Definition saved and audited."); load();
  };

  return <div className="space-y-6"><Card><CardHeader><CardTitle className="flex items-center justify-between">{copy.title}<Button variant="ghost" size="icon" onClick={load} title="Refresh definitions" aria-label="Refresh definitions"><RefreshCw className="h-4 w-4" /></Button></CardTitle></CardHeader><CardContent><div className="grid gap-4 md:grid-cols-2"><div><Label htmlFor={`${resource}-key`}>{copy.key}</Label><Input id={`${resource}-key`} value={key} onChange={(event) => setKey(event.target.value)} placeholder="unique-key" /></div><div><Label htmlFor={`${resource}-name`}>{copy.name}</Label><Input id={`${resource}-name`} value={name} onChange={(event) => setName(event.target.value)} placeholder={resource === "feature" ? "What this flag controls" : "Display name"} /></div></div><div className="mt-4"><Label htmlFor={`${resource}-definition`}>{resource === "feature" ? "Configuration" : "Definition JSON"}</Label><Textarea id={`${resource}-definition`} value={definition} onChange={(event) => setDefinition(event.target.value)} rows={5} className="font-mono text-xs" placeholder='{"conditions": [], "actions": []}' /></div><div className="mt-4 flex items-center justify-between gap-3"><p className="text-sm text-muted-foreground">Changes are persisted independently from application code and recorded in the admin audit log.</p><Button onClick={save} disabled={!key.trim() || (resource !== "setting" && !name.trim())}><Plus className="h-4 w-4" />Save definition</Button></div>{message && <p className="mt-3 text-sm text-muted-foreground">{message}</p>}</CardContent></Card><Card><CardHeader><CardTitle>Configured definitions</CardTitle></CardHeader><CardContent>{!items.length ? <p className="text-sm text-muted-foreground">No definitions configured yet.</p> : <div className="divide-y divide-border">{items.map((item, index) => <div key={item.id ?? index} className="flex items-center justify-between gap-4 py-3"><div><p className="text-sm font-medium">{item.name ?? item.form_key ?? item.workflow_key ?? item.event_key ?? item.report_key ?? item.setting_key ?? item.flag_key}</p><p className="text-xs text-muted-foreground">{item.status ?? (item.enabled === false ? "Disabled" : "Active")}</p></div><Badge variant={item.enabled === false ? "neutral" : "success"}>{item.enabled === false ? "Disabled" : "Configured"}</Badge></div>)}</div>}</CardContent></Card></div>;
}
