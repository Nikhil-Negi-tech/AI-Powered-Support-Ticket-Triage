"use client";

import * as React from "react";
import { useRouter } from "next/navigation";
import { AlertTriangle, Check, Loader2, Send } from "lucide-react";

import { Button } from "@/components/ui/button";
import { Label } from "@/components/ui/label";
import { Select } from "@/components/ui/select";

interface Props {
  reference: string;
  currentStatus: string;
  currentComment: string;
}

export function ApproverDecisionPanel({
  reference,
  currentStatus,
  currentComment,
}: Props) {
  const router = useRouter();

  const [status, setStatus] = React.useState(currentStatus);
  const [comment, setComment] = React.useState(currentComment);

  const [saving, setSaving] = React.useState(false);
  const [saved, setSaved] = React.useState(false);
  const [error, setError] = React.useState<string | null>(null);

  const dirty =
    status !== currentStatus || comment !== currentComment;

  async function handleSave() {
    setSaving(true);
    setError(null);
    setSaved(false);

    try {
      const res = await fetch(
        `/api/requests/${encodeURIComponent(reference)}/approvers`,
        {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            status,
            comment,
          }),
        }
      );

      if (!res.ok) {
        const data = (await res
          .json()
          .catch(() => ({}))) as {
          error?: string;
        };

        throw new Error(
          data.error ?? "Failed to save decision"
        );
      }

      setSaved(true);
      router.refresh();
    } catch (e) {
      setError(
        e instanceof Error
          ? e.message
          : "Failed to save decision"
      );
    } finally {
      setSaving(false);
    }
  }

  return (
    <div className="space-y-5">
      <div className="rounded-lg border border-amber-500/20 bg-amber-500/5 px-3 py-2.5 text-xs leading-5 text-muted-foreground">
        Your decision is recorded in the request history and may trigger notifications to the requester and support team.
      </div>
      <div className="space-y-1.5">
        <Label htmlFor="approval-status">
          Approval Status
        </Label>

        <Select
          id="approval-status"
          value={status}
          onChange={(e) => {
            setStatus(e.target.value);
            setSaved(false);
          }}
        >
          <option value="Active">Active</option>

          <option value="Approved">
            Approved
          </option>

          <option value="On Hold">
            On Hold
          </option>

          <option value="Cancelled">
            Cancelled
          </option>
        </Select>
      </div>

      {status === "Cancelled" && (
        <div className="flex items-start gap-2 rounded-lg border border-destructive/20 bg-destructive/5 px-3 py-2.5 text-xs leading-5 text-destructive">
          <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" />
          Cancelling this approval will stop your approval step. Add a comment explaining the decision.
        </div>
      )}

      <div className="space-y-1.5">
        <Label htmlFor="approval-comment">
          Approval Comment
        </Label>

        <textarea
          id="approval-comment"
          rows={4}
          value={comment}
          onChange={(e) => {
            setComment(e.target.value);
            setSaved(false);
          }}
          placeholder="Add approval comments..."
          className="w-full rounded-md border border-border bg-background px-3 py-2 text-sm"
        />
      </div>

      {error && (
        <p className="rounded-md bg-destructive/10 px-3 py-2 text-sm text-destructive">
          {error}
        </p>
      )}

      {saved && !dirty && (
        <p className="flex items-center gap-1.5 rounded-md bg-success/10 px-3 py-2 text-sm text-success">
          <Check className="h-4 w-4" />
          Decision saved successfully.
        </p>
      )}

      <Button
        onClick={handleSave}
        disabled={saving || !dirty}
        className="w-full"
      >
        {saving && (
          <Loader2 className="h-4 w-4 animate-spin" />
        )}

        {!saving && <Send className="h-4 w-4" />}
        {saving ? "Saving decision…" : "Save Decision"}
      </Button>
    </div>
  );
}
