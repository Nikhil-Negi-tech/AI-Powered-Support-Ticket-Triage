import { notFound } from "next/navigation";
import Link from "next/link";
import {
  ArrowLeft,
  Clock,
  FileText,
  History,
  ShieldCheck,
  Users,
} from "lucide-react";
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { UserAvatar } from "@/components/ui/user-avatar";
import { Badge } from "@/components/ui/badge";
import { StatusBadge, PriorityBadge } from "@/components/ui/status-badges";
import { EmptyState } from "@/components/ui/empty-state";
import { RequestComments } from "@/components/requests/RequestComments";
import { getSessionUser } from "@/lib/session";
import { getRequestByReference } from "@/lib/services/requests";
import { getUserById } from "@/lib/users-db";
import { listRequestAttachments } from "@/lib/services/attachments";
import { formatDateTime, stripHtml, formatFileSize } from "@/lib/utils";
import type { Priority, RequestStatus } from "@/lib/types";
import { canManageRequests } from "@/lib/permissions";
import { RequestManagementPanel } from "@/components/requests/RequestManagementPanel";
import type { ApproverStatus } from "@/lib/types";
import { ApproverDecisionPanel } from "@/components/requests/ApproverDecisionPanel";

export const dynamic = "force-dynamic";

const TYPE_LABELS: Record<string, string> = {
  general: "General Request",
  "hr-onboarding": "HR Onboarding",
  "hr-offboarding": "HR Offboarding",
  "infosec-exception": "InfoSec Exception",
};

const APPROVER_TONE: Record<string, string> = {
  Active: "default",
  Approved: "success",
  "On Hold": "warning",
  Cancelled: "secondary",
};

interface RequestRecord {
  id: string;
  reference: string;
  request_type: string;
  title: string;
  description: string;
  status: string;
  priority: string;
  requester_name: string;
  requester_email: string;
  requested_for_name: string | null;
  requested_for_email: string | null;
  department: string;
  assigned_to: string | null;
  assigned_to_name: string | null;
  payload: Record<string, unknown>;
  requester_department: string;
  requested_for_department: string;
  assigned_department: string;
  created_at: string;
  updated_at: string;
  completed_at: string | null;
  requested_by: string | null;
}

export default async function RequestDetailPage({
  params,
}: {
  params: Promise<{ formId: string }>;
}) {
  const sessionUser = await getSessionUser();
  if (!sessionUser) notFound();
  const { formId } = await params;
  const reference = decodeURIComponent(formId);
  const data = await getRequestByReference(reference);
  const canManage = await canManageRequests(sessionUser);
  if (!data) notFound();

  const r = data.request as unknown as RequestRecord;
  const requesterDirectoryUser = r.requested_by
    ? await getUserById(r.requested_by)
    : null;
  const approvers = data.approvers as unknown as {
    id: string;
    approver_id: string;
    approver_name: string;
    approver_email: string;
    approval_status: ApproverStatus;
    approval_comment: string;
  }[];
  const currentApprover = approvers.find(
    (a) =>
      a.approver_email.toLowerCase() ===
      sessionUser.email.toLowerCase()
  );
  const approvalSummary = {
    total: approvers.length,

    approved: approvers.filter(
      (a) => a.approval_status === "Approved"
    ).length,

    active: approvers.filter(
      (a) => a.approval_status === "Active"
    ).length,

    onHold: approvers.filter(
      (a) => a.approval_status === "On Hold"
    ).length,

    cancelled: approvers.filter(
      (a) => a.approval_status === "Cancelled"
    ).length,
  };
  const followers = data.followers as unknown as {
    id: string;
    user_name: string;
    user_email: string;
  }[];
  const comments = data.comments as unknown as {
    id: string;
    author_name: string;
    comment: string;
    created_at: string;
  }[];
  const activity = data.activity as unknown as {
    id: string;
    activity_type: string;
    description: string;
    performed_by_name: string | null;
    created_at: string;
  }[];

  const detailEntries = Object.entries(r.payload ?? {}).filter(
    ([key, value]) => {
      if (key === "descriptionHtml") return false;
      if (key === "attachments") return false;

      if (typeof value === "string") {
        return value.trim().length > 0;
      }

      if (typeof value === "number") {
        return true;
      }

      if (Array.isArray(value)) {
        return value.length > 0;
      }

      // Skip nested objects (e.g. customQuestions) — not renderable as a value.
      return false;
    }
  );

  const attachmentFiles = await listRequestAttachments(r.id);

  return (
    <main className="min-h-screen bg-background">
      <div className="mx-auto max-w-6xl px-4 py-8 sm:px-6">
        <Link
          href="/requests"
          className="mb-4 inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
        >
          <ArrowLeft className="h-4 w-4" />
          Back to requests
        </Link>

        <div className="mb-6 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <div className="font-mono text-xs text-primary">{r.reference}</div>
            <h1 className="mt-1 text-2xl font-semibold tracking-tight text-foreground">
              {r.title}
            </h1>
            <p className="mt-1 text-sm text-muted-foreground">
              {TYPE_LABELS[r.request_type] ?? r.request_type}
              {r.department ? ` · ${r.department}` : ""}
            </p>
          </div>
          <div className="flex items-center gap-2">
            <PriorityBadge priority={r.priority as Priority} />
            <StatusBadge status={r.status as RequestStatus} />
          </div>
        </div>

        <div className="grid grid-cols-1 gap-6 lg:grid-cols-3">
          {/* Left column */}
          <div className="space-y-6 lg:col-span-2">
            <Card>
              <CardHeader>
                <CardTitle>Description</CardTitle>
              </CardHeader>
              <CardContent>
                <p className="whitespace-pre-wrap text-sm leading-relaxed text-foreground">
                  {stripHtml(r.description) || "No description provided."}
                </p>
              </CardContent>
            </Card>
            {detailEntries.length > 0 && (
              <Card>
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <FileText className="h-4 w-4 text-muted-foreground" />
                    Details
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <dl className="grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
                    {detailEntries.map(([key, value]) => (
                      <div key={key}>
                        <dt className="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                          {key
                            .replace(/([A-Z])/g, " $1")
                            .replace(/^./, (c) => c.toUpperCase())}
                        </dt>
                        <dd className="mt-0.5 text-sm text-foreground">
                          {Array.isArray(value)
                            ? value.join(", ")
                            : String(value)}
                        </dd>
                      </div>
                    ))}
                  </dl>
                </CardContent>
              </Card>
            )}

            {attachmentFiles.length > 0 && (
              <Card>
                <CardHeader>
                  <CardTitle>Attachments</CardTitle>
                </CardHeader>

                <CardContent>
                  <div className="space-y-2">
                    {attachmentFiles.map((file) => (
                      <a
                        key={file.id}
                        href={`/api/attachments/${file.id}`}
                        className="flex items-center justify-between rounded-md border border-border p-3 transition-colors hover:bg-secondary"
                      >
                        <div className="flex min-w-0 items-center gap-2.5">
                          <FileText className="h-4 w-4 shrink-0 text-muted-foreground" />
                          <div className="min-w-0">
                            <div className="truncate font-medium text-foreground">
                              {file.file_name}
                            </div>
                            <div className="text-xs text-muted-foreground">
                              {file.file_type || "Unknown type"}
                            </div>
                          </div>
                        </div>

                        <div className="shrink-0 text-xs text-muted-foreground">
                          {formatFileSize(Number(file.file_size))}
                        </div>
                      </a>
                    ))}
                  </div>
                </CardContent>
              </Card>
            )}

            {/* Approval panel */}
            <Card>
              <CardHeader>
                <CardTitle>
                  Approval Summary
                </CardTitle>
              </CardHeader>

              <CardContent>
                <div className="grid grid-cols-2 gap-3">
                  <div className="rounded-lg border p-3">
                    <div className="text-xs text-muted-foreground">
                      Total
                    </div>
                    <div className="text-2xl font-bold">
                      {approvalSummary.total}
                    </div>
                  </div>

                  <div className="rounded-lg border p-3">
                    <div className="text-xs text-muted-foreground">
                      Approved
                    </div>
                    <div className="text-2xl font-bold text-green-600">
                      {approvalSummary.approved}
                    </div>
                  </div>

                  <div className="rounded-lg border p-3">
                    <div className="text-xs text-muted-foreground">
                      Pending
                    </div>
                    <div className="text-2xl font-bold text-blue-600">
                      {approvalSummary.active}
                    </div>
                  </div>

                  <div className="rounded-lg border p-3">
                    <div className="text-xs text-muted-foreground">
                      On Hold
                    </div>
                    <div className="text-2xl font-bold text-yellow-600">
                      {approvalSummary.onHold}
                    </div>
                  </div>
                </div>
              </CardContent>
            </Card>
            {currentApprover && (
              <Card>
                <CardHeader>
                  <CardTitle>
                    Approval Decision
                  </CardTitle>
                </CardHeader>

                <CardContent>
                  <ApproverDecisionPanel
                    reference={r.reference}
                    currentStatus={currentApprover.approval_status}
                    currentComment={currentApprover.approval_comment ?? ""}
                  />
                </CardContent>
              </Card>
            )}
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <ShieldCheck className="h-4 w-4 text-primary" />
                  Approvers
                </CardTitle>
              </CardHeader>
              <CardContent>
                {approvers.length === 0 ? (
                  <p className="text-sm text-muted-foreground">
                    No approvers assigned to this request.
                  </p>
                ) : (
                  <ul className="space-y-3">
                    {approvers.map((a) => (
                      <li
                        key={a.id}
                        className="rounded-lg border border-border p-3"
                      >
                        <div className="flex items-center gap-2.5">
                          <UserAvatar name={a.approver_name} size="md" />
                          <div className="min-w-0 flex-1">
                            <div className="truncate text-sm font-medium text-foreground">
                              {a.approver_name}
                            </div>
                            <div className="truncate text-xs text-muted-foreground">
                              {a.approver_email}
                            </div>
                          </div>
                          <Badge
                            variant={
                              (APPROVER_TONE[a.approval_status] ??
                                "neutral") as never
                            }
                          >
                            {a.approval_status}
                          </Badge>
                        </div>
                        {a.approval_comment && (
                          <p className="mt-2 rounded-md bg-muted/50 px-3 py-2 text-sm text-muted-foreground">
                            {a.approval_comment}
                          </p>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </CardContent>
            </Card>

            {/* Comments */}
            <Card>
              <CardHeader>
                <CardTitle>Comments</CardTitle>
              </CardHeader>
              <CardContent>
                <RequestComments
                  reference={r.reference}
                  initialComments={comments}
                />
              </CardContent>
            </Card>

            {/* Activity timeline */}
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <History className="h-4 w-4 text-muted-foreground" />
                  Activity Timeline
                </CardTitle>
              </CardHeader>
              <CardContent>
                {activity.length === 0 ? (
                  <EmptyState
                    icon={History}
                    title="No activity yet"
                    description="Actions on this request will be recorded here."
                    className="py-8"
                  />
                ) : (
                  <ol className="relative space-y-5 border-l border-border pl-5">
                    {activity.map((entry) => (
                      <li key={entry.id} className="relative">
                        <span className="absolute -left-[23px] top-1 h-2.5 w-2.5 rounded-full border-2 border-card bg-primary" />
                        <p className="text-sm text-foreground">
                          <span className="font-medium">
                            {entry.performed_by_name ?? "System"}
                          </span>{" "}
                          {entry.description}
                        </p>
                        <p className="text-xs text-muted-foreground">
                          {entry.activity_type} ·{" "}
                          {formatDateTime(new Date(entry.created_at))}
                        </p>
                      </li>
                    ))}
                  </ol>
                )}
              </CardContent>
            </Card>
          </div>

          {/* Right column */}
          <div className="space-y-6">
            {canManage && (
              <Card>
                <CardHeader>
                  <CardTitle>Request Management</CardTitle>
                </CardHeader>

                <CardContent>
                  <RequestManagementPanel
                    reference={r.reference}
                    initialStatus={r.status}
                    initialPriority={r.priority}
                    initialAssignee={
                      r.assigned_to_name
                        ? {
                          id: r.assigned_to ?? "",
                          name: r.assigned_to_name,
                          email: "",
                          department: r.assigned_department ?? "",
                        }
                        : null
                    }
                    initialDepartment={r.assigned_department ?? ""}
                    initialApprovers={approvers.map((a) => ({
                      id: a.approver_id,
                      name: a.approver_name,
                      email: a.approver_email,
                      department: "",
                      status: a.approval_status as ApproverStatus,
                      comment: a.approval_comment ?? "",
                    }))}
                  />
                </CardContent>
              </Card>
            )}
            <Card>
              <CardHeader>
                <CardTitle>Request Information</CardTitle>
              </CardHeader>
              <CardContent className="space-y-3 text-sm">
                <InfoRow label="Status">
                  <StatusBadge status={r.status as RequestStatus} />
                </InfoRow>
                <InfoRow label="Priority">
                  <PriorityBadge priority={r.priority as Priority} />
                </InfoRow>
                <InfoRow label="Type">
                  {TYPE_LABELS[r.request_type] ?? r.request_type}
                </InfoRow>
                <InfoRow label="Requester Department">
                  {r.requester_department || "—"}
                </InfoRow>

                <InfoRow label="Requested For Department">
                  {r.requested_for_department || "—"}
                </InfoRow>

                <InfoRow label="Assigned Department">
                  {r.assigned_department || "—"}
                </InfoRow>
                <InfoRow label="Assigned To">
                  {r.assigned_to_name ? (
                    <span className="flex items-center gap-2">
                      <UserAvatar name={r.assigned_to_name} size="sm" />
                      {r.assigned_to_name}
                    </span>
                  ) : (
                    <span className="text-muted-foreground">Unassigned</span>
                  )}
                </InfoRow>
                <InfoRow label="Created">
                  <span className="flex items-center gap-1.5">
                    <Clock className="h-4 w-4 text-muted-foreground" />
                    {formatDateTime(new Date(r.created_at))}
                  </span>
                </InfoRow>
                <InfoRow label="Updated">
                  {formatDateTime(new Date(r.updated_at))}
                </InfoRow>
              </CardContent>
            </Card>

            <Card>
              <CardHeader>
                <CardTitle>Requester</CardTitle>
              </CardHeader>
              <CardContent className="space-y-3 text-sm">
                <div className="flex items-center gap-3">
                  <UserAvatar name={r.requester_name} size="md" />
                  <div className="min-w-0">
                    <div className="font-medium text-foreground">
                      {r.requester_name}
                    </div>
                    <div className="truncate text-xs text-muted-foreground">
                      {r.requester_email}
                    </div>
                  </div>
                </div>
                {requesterDirectoryUser && (
                  <div className="rounded-lg border border-border bg-muted/40 p-3">
                    <div className="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                      Manager
                    </div>
                    <div className="mt-1 text-sm font-medium text-foreground">
                      {requesterDirectoryUser.managerName || "N/A"}
                    </div>
                    {requesterDirectoryUser.managerEmail && requesterDirectoryUser.managerEmail !== "N/A" && (
                      <div className="text-xs text-muted-foreground">
                        {requesterDirectoryUser.managerEmail}
                      </div>
                    )}
                  </div>
                )}
                {r.requested_for_name && (
                  <div className="rounded-lg border border-border bg-muted/40 p-3">
                    <div className="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                      Requested For
                    </div>
                    <div className="mt-1 flex items-center gap-2">
                      <UserAvatar name={r.requested_for_name} size="sm" />
                      <div className="min-w-0">
                        <div className="truncate text-sm font-medium text-foreground">
                          {r.requested_for_name}
                        </div>
                        <div className="truncate text-xs text-muted-foreground">
                          {r.requested_for_email}
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </CardContent>
            </Card>

            {followers.length > 0 && (
              <Card>
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <Users className="h-4 w-4 text-muted-foreground" />
                    Followers
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <ul className="space-y-2">
                    {followers.map((f) => (
                      <li key={f.id} className="flex items-center gap-2.5">
                        <UserAvatar name={f.user_name} size="sm" />
                        <div className="min-w-0">
                          <div className="truncate text-sm font-medium text-foreground">
                            {f.user_name}
                          </div>
                          <div className="truncate text-xs text-muted-foreground">
                            {f.user_email}
                          </div>
                        </div>
                      </li>
                    ))}
                  </ul>
                </CardContent>
              </Card>
            )}
          </div>
        </div>
      </div>
    </main>
  );
}

function InfoRow({
  label,
  children,
}: {
  label: string;
  children: React.ReactNode;
}) {
  return (
    <div className="flex items-center justify-between gap-4">
      <span className="text-muted-foreground">{label}</span>
      <span className="text-right font-medium text-foreground">{children}</span>
    </div>
  );
}
