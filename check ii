/** Comment Added — notify requester, assignee and followers (never the author). */
export async function notifyCommentAdded(
  requestId: string,
  author: ActorRef,
  comment: string
): Promise<void> {
  return safely("commentAdded", async () => {
    const ctx = await loadContext(requestId);
    if (!ctx) return;
    const url = getRequestUrl(ctx.reference);
    const recipients = excludeRecipient(
      compact([
        requesterRecipient(ctx),
        await assigneeRecipient(ctx),
        ...ctx.followers,
      ]),
      author.email
    );

    await dispatch({
      ctx,
      type: "comment_added",
      recipients,
      inApp: () => ({
        title: "New Comment",
        message: `${author.name} commented on ${ctx.reference}.`,
      }),
      email: (r) =>
        buildCommentEmail({
          recipientName: r.name,
          reference: ctx.reference,
          title: ctx.title,
          authorName: author.name,
          comment,
          url,
        }),
    });
  });
}

/** Follower Added — notify a single newly added follower. */
export async function notifyFollowerAdded(
  requestId: string,
  follower: Recipient,
  actor: ActorRef
): Promise<void> {
  return safely("followerAdded", async () => {
    const ctx = await loadContext(requestId);
    if (!ctx || !follower.email) return;
    const url = getRequestUrl(ctx.reference);

    await dispatch({
      ctx,
      type: "follower_added",
      recipients: [follower],
      inApp: () => ({
        title: "Added As Follower",
        message: `You were added as a follower on ${ctx.reference}.`,
      }),
      email: (r) =>
        buildFollowerEmail({
          followerName: r.name,
          reference: ctx.reference,
          title: ctx.title,
          addedByName: actor.name,
          url,
        }),
    });
  });
}

/**
 * Mention — notify each mentioned user once (self-mentions excluded).
 * Also appends a "Mention Added" activity entry per mentioned user.
 * `mentions` is verified by the caller to actually appear in the comment text.
 */
export async function notifyMentions(
  requestId: string,
  author: ActorRef,
  comment: string,
  mentions: Recipient[]
): Promise<void> {
  return safely("mentions", async () => {
    const ctx = await loadContext(requestId);
    if (!ctx) return;
    const url = getRequestUrl(ctx.reference);

    const recipients = excludeRecipient(
      deduplicateRecipients(mentions),
      author.email
    );
    if (recipients.length === 0) return;

    // Activity trail: one "Mention Added" entry per mentioned user.
    for (const r of recipients) {
      try {
        await q(
          `INSERT INTO request_activity
             (request_id, activity_type, description, performed_by, performed_by_name)
           VALUES ($1, 'Mention Added', $2, $3, $4)`,
          [requestId, `mentioned ${r.name} in a comment.`, author.id, author.name]
        );
      } catch (error) {
        console.error("[notifications] mention activity failed", error);
      }
    }

    await dispatch({
      ctx,
      type: "mention",
      recipients,
      inApp: () => ({
        title: "You Were Mentioned",
        message: `${author.name} mentioned you in ${ctx.reference}.`,
      }),
      email: (r) =>
        buildMentionEmail({
          mentionedName: r.name,
          reference: ctx.reference,
          title: ctx.title,
          mentionedByName: author.name,
          comment,
          url,
        }),
    });
  });
}
