"use client";

import * as React from "react";
import {
  Activity,
  ArrowUp,
  Bell,
  BookOpen,
  BriefcaseBusiness,
  CheckCircle2,
  ClipboardList,
  FileBarChart,
  GitBranch,
  LayoutDashboard,
  Plus,
  Settings2,
  ShieldCheck,
  Users,
  Workflow,
} from "lucide-react";
import { AdminManager } from "@/components/admin/AdminManager";
import { UserManagementPanel } from "@/components/admin/UserManagementPanel";
import { RequestFormManager } from "@/components/admin/RequestFormManager";
import { MetadataManager } from "@/components/admin/MetadataManager";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Select } from "@/components/ui/select";

type Section = "overview" | "directory" | "approvals" | "forms" | "business" | "workflows" | "notifications" | "reports" | "audit" | "settings" | "access";

interface ConfigurationData {
  departments: Array<{ id: string; name: string; code: string; is_active: boolean }>;
  categories: Array<{ id: string; name: string; slug: string; is_active: boolean }>;
  policies: Array<{ id: string; name: string; request_type: string; steps: Array<{ name: string; approver_type: string; approver_value: string }> }>;
  permissions: Array<{ role: string; permission: string; granted: boolean }>;
  counts: { users: number; departments: number; policies: number; audits: number };
}

const NAV: Array<{ id: Section; label: string; description: string; icon: typeof Users }> = [
  { id: "overview", label: "Overview", description: "System health and administration activity", icon: LayoutDashboard },
  { id: "directory", label: "Users & Directory", description: "Entra users, roles and department ownership", icon: Users },
  { id: "approvals", label: "Approvals", description: "Approval policies, delegates and simulation", icon: CheckCircle2 },
  { id: "forms", label: "Request Forms", description: "Form catalog and versioned field definitions", icon: ClipboardList },
  { id: "business", label: "Departments & Categories", description: "Business taxonomy used by request forms", icon: BookOpen },
  { id: "workflows", label: "Workflows", description: "Status, assignment and escalation rules", icon: GitBranch },
  { id: "notifications", label: "Notifications", description: "Events, channels and message templates", icon: Bell },
  { id: "reports", label: "Reports & Export", description: "Saved reports, schedules and exports", icon: FileBarChart },
  { id: "audit", label: "Audit Logs", description: "Administrative change history", icon: Activity },
  { id: "settings", label: "Portal Settings", description: "Branding, defaults and feature flags", icon: Settings2 },
  { id: "access", label: "Access Control", description: "Roles and configurable permissions", icon: ShieldCheck },
];

export function AdministrationCenter({ analytics }: { analytics: { total: number; open: number; urgent: number; byStatus: Record<string, number> } }) {
  const [data, setData] = React.useState<ConfigurationData | null>(null);
  const [error, setError] = React.useState("");
  const [refresh, setRefresh] = React.useState(0);
  const [showBackToTop, setShowBackToTop] = React.useState(false);

  React.useEffect(() => {
    fetch("/api/admin/configuration")
      .then(async (response) => {
        const body = await response.json();
        if (!response.ok) throw new Error(body.error ?? "Unable to load administration configuration");
        setData(body);
      })
      .catch((reason: unknown) => setError(reason instanceof Error ? reason.message : "Unable to load administration configuration"));
  }, [refresh]);

  React.useEffect(() => {
    const onScroll = () => setShowBackToTop(window.scrollY > 520);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
    return () => window.removeEventListener("scroll", onScroll);
  }, []);

  return (
    <main className="min-h-screen bg-background">
      <div className="mx-auto max-w-[1500px] px-4 py-6 sm:px-6 lg:px-8">
        <header className="mb-6">
          <h1 className="text-2xl font-semibold tracking-tight text-foreground">Administration</h1>
          <p className="mt-1 text-sm text-muted-foreground">Manage users, requests, approvals, workflows, and portal settings.</p>
        </header>

        {error && <p className="mb-4 rounded-md border border-destructive/30 bg-destructive/5 px-3 py-2 text-sm text-destructive">{error}</p>}

        <div className="space-y-8">
          <section aria-labelledby="quick-actions-heading">
            <SectionHeading id="quick-actions-heading" title="Quick actions" />
            <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
              <QuickAction href="#users" icon={Users} label="Add or manage users" />
              <QuickAction href="#forms" icon={ClipboardList} label="Create a request form" />
              <QuickAction href="#workflows" icon={GitBranch} label="Create a workflow" />
              <QuickAction href="#audit" icon={Activity} label="View audit logs" />
            </div>
          </section>

          <section aria-labelledby="summary-heading">
            <SectionHeading id="summary-heading" title="Administration at a glance" />
            <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
              <SummaryCard label="Active users" value={data?.counts.users ?? "—"} icon={Users} href="#users" />
              <SummaryCard label="Open requests" value={analytics.open} icon={BriefcaseBusiness} href="#reports" />
              <SummaryCard label="Approval policies" value={data?.counts.policies ?? "—"} icon={CheckCircle2} href="#approvals" />
              <SummaryCard label="Urgent requests" value={analytics.urgent} icon={ShieldCheck} href="#reports" />
              <SummaryCard label="Audit events" value={data?.counts.audits ?? "—"} icon={Activity} href="#audit" />
            </div>
          </section>

          <section aria-labelledby="modules-heading">
            <SectionHeading id="modules-heading" title="Administration modules" />
            <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
              <ModuleCard href="#users" icon={Users} title="Users & Directory" value={data?.counts.users ?? "—"} detail="Manage users, roles and departments" />
              <ModuleCard href="#approvals" icon={CheckCircle2} title="Approvers" value={data?.counts.policies ?? "—"} detail="Manage policies and delegations" />
              <ModuleCard href="#forms" icon={ClipboardList} title="Request Forms" value="Catalog" detail="Edit and publish intake forms" />
              <ModuleCard href="#workflows" icon={GitBranch} title="Workflows" value="Metadata" detail="Manage routing and status rules" />
              <ModuleCard href="#notifications" icon={Bell} title="Notifications" value="Events" detail="Manage channels and templates" />
              <ModuleCard href="#reports" icon={FileBarChart} title="Reports & Export" value="CSV" detail="Review and export operations data" />
              <ModuleCard href="#audit" icon={Activity} title="Audit Logs" value={data?.counts.audits ?? "—"} detail="Review administrative changes" />
              <ModuleCard href="#settings" icon={Settings2} title="Settings" value="Portal" detail="Manage flags and configuration" />
            </div>
          </section>

          <div className="grid gap-6 xl:grid-cols-[1.1fr_0.9fr]">
            <section aria-labelledby="health-heading">
              <SectionHeading id="health-heading" title="System health" />
              <Card><CardContent className="grid gap-3 p-4 sm:grid-cols-2">{[["Directory Sync", "Healthy"], ["Database", "Healthy"], ["Notifications", "Healthy"], ["Workflow Engine", "Healthy"], ["Audit Logging", "Healthy"]].map(([label, status]) => <div key={label} className="flex items-center justify-between rounded-md border border-border px-3 py-2.5"><span className="text-sm text-foreground">{label}</span><Badge variant="success"><span className="h-1.5 w-1.5 rounded-full bg-current" />{status}</Badge></div>)}</CardContent></Card>
            </section>
            <section aria-labelledby="actions-heading">
              <SectionHeading id="actions-heading" title="Pending administrative actions" />
              <Card><CardContent className="space-y-2 p-4"><ActionRow href="#users" label="Users requiring role assignment" value="Review directory" /><ActionRow href="#workflows" label="Unpublished workflows" value="Review workflows" /><ActionRow href="#approvals" label="Approval policies without approvers" value="Review approvals" /><ActionRow href="#forms" label="Draft forms awaiting publication" value="Review forms" /></CardContent></Card>
            </section>
          </div>

          <section aria-labelledby="activity-heading"><div className="mb-3 flex items-center justify-between"><SectionHeading id="activity-heading" title="Recent administrative activity" /><a href="#audit" className="text-sm font-medium text-primary hover:underline">View all</a></div><AuditPanel refresh={refresh} /></section>

          <section id="users" className="scroll-mt-6"><SectionHeading title="Users & Directory" /><UserManagementPanel /><AdminManager /></section>
          <section id="approvals" className="scroll-mt-6"><SectionHeading title="Approvals" /><ApprovalConfiguration data={data} onSaved={() => setRefresh((value) => value + 1)} /></section>
          <section id="forms" className="scroll-mt-6"><SectionHeading title="Request Forms" /><RequestFormManager /></section>
          <section id="workflows" className="scroll-mt-6"><SectionHeading title="Workflows" /><MetadataManager resource="workflow" /></section>
          <section id="notifications" className="scroll-mt-6"><SectionHeading title="Notifications" /><MetadataManager resource="notification" /></section>
          <section id="reports" className="scroll-mt-6"><SectionHeading title="Reports & Export" /><div className="space-y-4"><div className="flex justify-end"><a href="/api/admin/reports/export" className="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-blue-700">Export requests CSV</a></div><MetadataManager resource="report" /></div></section>
          <section id="audit" className="scroll-mt-6"><SectionHeading title="Audit Logs" /><AuditPanel refresh={refresh} /></section>
          <section id="settings" className="scroll-mt-6"><SectionHeading title="Portal Settings" /><div className="space-y-6"><MetadataManager resource="setting" /><MetadataManager resource="feature" /></div></section>
          <section id="access" className="scroll-mt-6"><SectionHeading title="Access Control" /><AccessPanel data={data} /></section>
        </div>
      </div>
      {showBackToTop && <button type="button" onClick={() => window.scrollTo({ top: 0, behavior: "smooth" })} aria-label="Back to top" title="Back to top" className="fixed bottom-6 right-6 z-30 flex h-11 w-11 items-center justify-center rounded-full border border-border bg-card text-foreground shadow-lg transition-colors hover:bg-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"><ArrowUp className="h-5 w-5" /></button>}
    </main>
  );
}

function SectionHeading({ id, title }: { id?: string; title: string }) {
  return <h2 id={id} className="mb-3 text-sm font-semibold uppercase tracking-wide text-muted-foreground">{title}</h2>;
}

function QuickAction({ href, icon: Icon, label }: { href: string; icon: typeof Users; label: string }) {
  return <a href={href} className="flex items-center gap-3 rounded-lg border border-border bg-card px-4 py-3 text-sm font-medium text-foreground shadow-sm transition-colors hover:border-primary/40 hover:bg-accent"><span className="flex h-8 w-8 items-center justify-center rounded-md bg-primary/10 text-primary"><Icon className="h-4 w-4" /></span>{label}</a>;
}

function SummaryCard({ href, icon: Icon, label, value }: { href: string; icon: typeof Users; label: string; value: number | string }) {
  return <a href={href} className="block"><Card className="card-hover p-4"><div className="flex items-start justify-between"><div><p className="text-sm font-medium text-muted-foreground">{label}</p><p className="mt-2 text-2xl font-semibold tracking-tight text-foreground">{value}</p></div><span className="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-100 text-blue-700"><Icon className="h-4 w-4" /></span></div></Card></a>;
}

function ModuleCard({ href, icon: Icon, title, value, detail }: { href: string; icon: typeof Users; title: string; value: number | string; detail: string }) {
  return <a href={href} className="block"><Card className="card-hover h-full p-4"><div className="flex items-start justify-between gap-3"><span className="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary"><Icon className="h-4 w-4" /></span><Badge variant="neutral">{value}</Badge></div><h3 className="mt-4 text-sm font-semibold text-foreground">{title}</h3><p className="mt-1 text-xs text-muted-foreground">{detail}</p></Card></a>;
}

function ActionRow({ href, label, value }: { href: string; label: string; value: string }) {
  return <a href={href} className="flex items-center justify-between gap-3 rounded-md border border-border px-3 py-2.5 text-sm transition-colors hover:bg-secondary"><span className="text-foreground">{label}</span><span className="shrink-0 text-xs font-medium text-primary">{value}</span></a>;
}

function Overview({ analytics, data, onNavigate }: { analytics: { total: number; open: number; urgent: number; byStatus: Record<string, number> }; data: ConfigurationData | null; onNavigate: (section: Section) => void }) {
  const metrics = [
    ["Active users", data?.counts.users ?? "—", Users, "directory" as Section],
    ["Open requests", analytics.open, BriefcaseBusiness, "reports" as Section],
    ["Pending approvals", analytics.byStatus["Approval Pending"] ?? 0, CheckCircle2, "approvals" as Section],
    ["Approval policies", data?.counts.policies ?? "—", Workflow, "approvals" as Section],
    ["Audit events", data?.counts.audits ?? "—", Activity, "audit" as Section],
  ] as const;
  return <div className="space-y-6">
    <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">{metrics.map(([label, value, Icon, target]) => <button type="button" key={label} onClick={() => onNavigate(target)} className="rounded-lg border border-border bg-card p-4 text-left shadow-sm transition-colors hover:border-primary/40 hover:bg-accent"><Icon className="h-4 w-4 text-primary" /><p className="mt-4 text-2xl font-semibold text-foreground">{value}</p><p className="mt-1 text-xs font-medium uppercase tracking-wide text-muted-foreground">{label}</p></button>)}</div>
    <div className="grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
      <Card><CardHeader><CardTitle>Administration operating model</CardTitle></CardHeader><CardContent className="grid gap-3 sm:grid-cols-2">{NAV.slice(1, 9).map((item) => { const Icon = item.icon; return <button type="button" key={item.id} onClick={() => onNavigate(item.id)} className="flex items-start gap-3 rounded-md border border-border p-3 text-left hover:bg-secondary"><Icon className="mt-0.5 h-4 w-4 text-primary" /><span><span className="block text-sm font-medium">{item.label}</span><span className="mt-1 block text-xs text-muted-foreground">{item.description}</span></span></button>; })}</CardContent></Card>
      <Card><CardHeader><CardTitle>System health</CardTitle></CardHeader><CardContent className="space-y-3">{[["Directory sync", "Connected"], ["Database migrations", "Managed on request"], ["Notification channels", "Email + bell"], ["Urgent requests", analytics.urgent]].map(([label, value]) => <div key={label} className="flex items-center justify-between border-b border-border pb-3 last:border-0 last:pb-0"><span className="text-sm text-muted-foreground">{label}</span><span className="flex items-center gap-1.5 text-sm font-medium text-foreground"><span className="h-1.5 w-1.5 rounded-full bg-success" />{value}</span></div>)}</CardContent></Card>
    </div>
  </div>;
}

function ApprovalConfiguration({ data, onSaved }: { data: ConfigurationData | null; onSaved: () => void }) {
  const [name, setName] = React.useState(""); const [requestType, setRequestType] = React.useState("*"); const [approverValue, setApproverValue] = React.useState(""); const [saving, setSaving] = React.useState(false); const [message, setMessage] = React.useState("");
  const save = async () => { setSaving(true); setMessage(""); try { const response = await fetch("/api/admin/configuration", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ type: "approval-policy", name, requestType, steps: [{ name: "Primary approval", approverType: "user", approverValue }] }) }); const body = await response.json(); if (!response.ok) throw new Error(body.error); setName(""); setApproverValue(""); setMessage("Approval policy saved and audited."); onSaved(); } catch (error) { setMessage(error instanceof Error ? error.message : "Unable to save policy"); } finally { setSaving(false); } };
  return <div className="space-y-6"><Card><CardHeader><CardTitle className="flex items-center justify-between">Create approval policy <Badge variant="neutral">Simulation-ready model</Badge></CardTitle></CardHeader><CardContent><div className="grid gap-4 md:grid-cols-3"><div><Label htmlFor="policy-name">Policy name</Label><Input id="policy-name" value={name} onChange={(event) => setName(event.target.value)} placeholder="e.g. HR onboarding approvals" /></div><div><Label htmlFor="policy-type">Request type</Label><Select id="policy-type" value={requestType} onChange={(event) => setRequestType(event.target.value)}><option value="*">All request types</option><option value="general">General request</option><option value="hr-onboarding">HR onboarding</option><option value="hr-offboarding">HR offboarding</option><option value="infosec-exception">InfoSec exception</option></Select></div><div><Label htmlFor="policy-approver">Approver identifier</Label><Input id="policy-approver" value={approverValue} onChange={(event) => setApproverValue(event.target.value)} placeholder="User ID, manager or role" /></div></div><div className="mt-4 flex items-center justify-between gap-3"><p className="text-sm text-muted-foreground">Additional levels, delegates, backup and escalation rules can be added to this policy record.</p><Button onClick={save} disabled={saving || !name.trim() || !approverValue.trim()}><Plus className="h-4 w-4" />{saving ? "Saving…" : "Add policy"}</Button></div>{message && <p className="mt-3 text-sm text-muted-foreground">{message}</p>}</CardContent></Card><Card><CardHeader><CardTitle>Configured policies</CardTitle></CardHeader><CardContent>{!data?.policies.length ? <p className="text-sm text-muted-foreground">No approval policies configured yet.</p> : <div className="divide-y divide-border">{data.policies.map((policy) => <div key={policy.id} className="flex items-center justify-between gap-4 py-3"><div><p className="text-sm font-medium">{policy.name}</p><p className="text-xs text-muted-foreground">{policy.request_type} · {policy.steps.length} level{policy.steps.length === 1 ? "" : "s"}</p></div><Badge variant="success">Active</Badge></div>)}</div>}</CardContent></Card></div>;
}

function BusinessConfiguration({ data, onSaved }: { data: ConfigurationData | null; onSaved: () => void }) {
  const [type, setType] = React.useState<"department" | "category">("department");
  const [name, setName] = React.useState("");
  const [code, setCode] = React.useState("");
  const [message, setMessage] = React.useState("");
  const save = async () => {
    setMessage("");
    const response = await fetch("/api/admin/configuration", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ type, name, ...(type === "department" ? { code } : { slug: code }) }) });
    const body = await response.json();
    if (!response.ok) { setMessage(body.error ?? "Unable to save configuration"); return; }
    setName(""); setCode(""); setMessage(`${type === "department" ? "Department" : "Category"} saved and audited.`); onSaved();
  };
  return <div className="space-y-6"><Card><CardHeader><CardTitle>Add business configuration</CardTitle></CardHeader><CardContent><div className="grid gap-4 md:grid-cols-3"><div><Label htmlFor="business-type">Type</Label><Select id="business-type" value={type} onChange={(event) => setType(event.target.value as "department" | "category")}><option value="department">Department</option><option value="category">Category</option></Select></div><div><Label htmlFor="business-name">Name</Label><Input id="business-name" value={name} onChange={(event) => setName(event.target.value)} placeholder="e.g. Finance" /></div><div><Label htmlFor="business-code">{type === "department" ? "Code" : "Slug"}</Label><Input id="business-code" value={code} onChange={(event) => setCode(event.target.value)} placeholder={type === "department" ? "FINANCE" : "finance"} /></div></div><div className="mt-4 flex items-center justify-between gap-3"><p className="text-sm text-muted-foreground">These values become managed references for forms, workflows and reports.</p><Button onClick={save} disabled={!name.trim() || !code.trim()}><Plus className="h-4 w-4" />Save {type}</Button></div>{message && <p className="mt-3 text-sm text-muted-foreground">{message}</p>}</CardContent></Card><div className="grid gap-6 md:grid-cols-2"><Card><CardHeader><CardTitle>Departments</CardTitle></CardHeader><CardContent>{!data?.departments.length ? <p className="text-sm text-muted-foreground">No departments configured.</p> : <div className="divide-y divide-border">{data.departments.map((item) => <div key={item.id} className="flex items-center justify-between py-3"><span className="text-sm font-medium">{item.name}</span><Badge variant={item.is_active ? "success" : "neutral"}>{item.code}</Badge></div>)}</div>}</CardContent></Card><Card><CardHeader><CardTitle>Categories</CardTitle></CardHeader><CardContent>{!data?.categories.length ? <p className="text-sm text-muted-foreground">No categories configured.</p> : <div className="divide-y divide-border">{data.categories.map((item) => <div key={item.id} className="flex items-center justify-between py-3"><span className="text-sm font-medium">{item.name}</span><Badge variant={item.is_active ? "success" : "neutral"}>{item.slug}</Badge></div>)}</div>}</CardContent></Card></div></div>;
}

function AuditPanel({ refresh }: { refresh: number }) { const [items, setItems] = React.useState<Array<{ id: string; actor_email: string; action: string; resource_type: string; created_at: string }>>([]); React.useEffect(() => { fetch("/api/admin/audit?limit=50").then((response) => response.json()).then((body) => setItems(body.items ?? [])); }, [refresh]); return <Card><CardHeader><CardTitle>Recent administrative activity</CardTitle></CardHeader><CardContent>{!items.length ? <p className="text-sm text-muted-foreground">No administrative events recorded yet.</p> : <div className="divide-y divide-border">{items.map((item) => <div key={item.id} className="flex items-center gap-3 py-3"><Activity className="h-4 w-4 shrink-0 text-primary" /><div className="min-w-0 flex-1"><p className="text-sm"><span className="font-medium">{item.actor_email}</span> {item.action} {item.resource_type}</p><p className="text-xs text-muted-foreground">{new Date(item.created_at).toLocaleString()}</p></div></div>)}</div>}</CardContent></Card>; }

function AccessPanel({ data }: { data: ConfigurationData | null }) {
  const roles = ["User", "Approver", "Manager", "Admin", "Super Admin"];
  const permissions = data?.permissions ?? [];
  return <Card><CardHeader><CardTitle>Role access overview</CardTitle><p className="text-sm text-muted-foreground">A compact view of what each portal role can access.</p></CardHeader><CardContent><div className="max-h-[25rem] overflow-y-auto rounded-lg border border-border"><div className="min-w-[680px]"><div className="sticky top-0 z-10 grid grid-cols-[150px_repeat(5,minmax(100px,1fr))] border-b border-border bg-muted px-3 py-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground"><span>Permission</span>{roles.map((role) => <span key={role} className="text-center">{role}</span>)}</div>{Array.from(new Set(permissions.map((permission) => permission.permission))).map((permission) => <div key={permission} className="grid grid-cols-[150px_repeat(5,minmax(100px,1fr))] items-center border-b border-border px-3 py-2.5 text-sm last:border-0"><span className="font-medium text-foreground">{permission}</span>{roles.map((role) => { const entry = permissions.find((item) => item.role === role && item.permission === permission); return <span key={role} className="text-center"><Badge variant={entry?.granted ? "success" : "neutral"}>{entry?.granted ? "Allowed" : "-"}</Badge></span>; })}</div>)}</div></div></CardContent></Card>;
}

function ExtensionPanel({ icon: Icon, title, text }: { icon: typeof Workflow; title: string; text: string }) { return <Card><CardContent className="flex min-h-56 flex-col items-center justify-center px-6 py-10 text-center"><Icon className="h-10 w-10 text-primary" /><h3 className="mt-4 text-lg font-semibold">{title}</h3><p className="mt-2 max-w-xl text-sm leading-6 text-muted-foreground">{text}</p><Badge variant="warning" className="mt-5">Configuration module</Badge></CardContent></Card>; }
