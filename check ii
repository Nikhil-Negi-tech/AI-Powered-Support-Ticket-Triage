import { NextResponse } from "next/server";
import { getSessionUser, isAdminEmail } from "@/lib/session";
import { listAdminAudit } from "@/lib/services/administration";

export const dynamic = "force-dynamic";

export async function GET(request: Request) {
  const user = await getSessionUser();
  if (!user || !(await isAdminEmail(user.email))) return NextResponse.json({ error: "Forbidden" }, { status: 403 });
  const params = new URL(request.url).searchParams;
  const limit = Number(params.get("limit") ?? "100");
  return NextResponse.json({ items: await listAdminAudit(limit, { query: params.get("q") ?? undefined, resourceType: params.get("resourceType") ?? undefined }) });
}
