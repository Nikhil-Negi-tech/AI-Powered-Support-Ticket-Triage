"use client";

import * as React from "react";
import {
  cloneDefaultRequestForms,
  parseRequestForms,
  type RequestFormDefinition,
  type RequestFormInput,
} from "@/lib/service-categories";

const REQUEST_FORMS_STORAGE_KEY = "itsm.request-forms.v2";
const REQUEST_FORMS_UPDATED_EVENT = "itsm:request-forms-updated";

function loadRequestForms(): RequestFormDefinition[] {
  try {
    const raw = window.localStorage.getItem(REQUEST_FORMS_STORAGE_KEY);

    if (!raw) return cloneDefaultRequestForms();

    return (
      parseRequestForms(JSON.parse(raw)) ??
      cloneDefaultRequestForms()
    );
  } catch {
    return cloneDefaultRequestForms();
  }
}

function persistRequestForms(forms: RequestFormDefinition[]) {
  try {
    window.localStorage.setItem(
      REQUEST_FORMS_STORAGE_KEY,
      JSON.stringify(forms)
    );

    window.dispatchEvent(new Event(REQUEST_FORMS_UPDATED_EVENT));
  } catch {
    // Keep in-memory changes available when browser storage is blocked.
  }
}

function createUniqueFormId(
  title: string,
  forms: RequestFormDefinition[]
): string {
  const base =
    title
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "") || "request";

  const existingIds = new Set(forms.map((form) => form.id));

  if (!existingIds.has(base)) return base;

  let suffix = 2;

  while (existingIds.has(`${base}-${suffix}`)) {
    suffix += 1;
  }

  return `${base}-${suffix}`;
}

export function useRequestFormCatalog() {
  const [forms, setForms] = React.useState<RequestFormDefinition[]>([]);
  const [isLoaded, setIsLoaded] = React.useState(false);
  const formsRef = React.useRef(forms);

  const syncFromStorage = React.useCallback(() => {
    const nextForms = loadRequestForms();

    formsRef.current = nextForms;
    setForms(nextForms);
    setIsLoaded(true);
  }, []);

  React.useEffect(() => {
    syncFromStorage();

    fetch("/api/request-forms")
      .then(async (response) => {
        if (!response.ok) return null;
        const body = await response.json();
        return parseRequestForms(body.forms);
      })
      .then((remoteForms) => {
        if (!remoteForms) return;
        formsRef.current = remoteForms;
        setForms(remoteForms);
        setIsLoaded(true);
      })
      .catch(() => {
        // Keep the local catalog as a temporary offline fallback.
      });

    const handleStorage = (event: StorageEvent) => {
      if (event.key === REQUEST_FORMS_STORAGE_KEY) {
        syncFromStorage();
      }
    };

    window.addEventListener("storage", handleStorage);
    window.addEventListener(
      REQUEST_FORMS_UPDATED_EVENT,
      syncFromStorage
    );

    return () => {
      window.removeEventListener("storage", handleStorage);
      window.removeEventListener(
        REQUEST_FORMS_UPDATED_EVENT,
        syncFromStorage
      );
    };
  }, [syncFromStorage]);

  const commit = React.useCallback(
    (nextForms: RequestFormDefinition[]) => {
      formsRef.current = nextForms;
      setForms(nextForms);
      persistRequestForms(nextForms);
    },
    []
  );

  const addForm = React.useCallback(
    (input: RequestFormInput) => {
      const currentForms = formsRef.current;

      const form: RequestFormDefinition = {
        ...input,
        id: createUniqueFormId(input.title, currentForms),
        template: "general",
      };

      commit([...currentForms, form]);
      void fetch("/api/request-forms", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(form),
      });

      return form;
    },
    [commit]
  );

  const updateForm = React.useCallback(
    (id: string, input: RequestFormInput) => {
      commit(
        formsRef.current.map((form) =>
          form.id === id ? { ...form, ...input } : form
        )
      );
      const next = formsRef.current.find((form) => form.id === id);
      if (next) {
        void fetch("/api/request-forms", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...next, ...input }),
        });
      }
    },
    [commit]
  );

  const deleteForm = React.useCallback(
    (id: string) => {
      commit(formsRef.current.filter((form) => form.id !== id));
      void fetch(`/api/request-forms?id=${encodeURIComponent(id)}`, {
        method: "DELETE",
      });
    },
    [commit]
  );

  return {
    forms,
    isLoaded,
    addForm,
    updateForm,
    deleteForm,
  };
}
