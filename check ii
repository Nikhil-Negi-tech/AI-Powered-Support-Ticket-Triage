"use client";

import * as React from "react";
import { useRouter } from "next/navigation";
import { Check, Loader2, Save } from "lucide-react";

import { Button } from "@/components/ui/button";
import { Select } from "@/components/ui/select";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { DirectoryPicker } from "@/components/general-request/DirectoryPickers";

import {
  WORKFLOW_STATUSES,
  PRIORITY_VALUES,
} from "@/lib/types";

import type {
  Person,
  Approver,
} from "@/lib/types";

interface Props {
  reference: string;
  initialStatus: string;
  initialPriority: string;
  initialAssignee: Person | null;
  initialDepartment: string;
  initialApprovers: Approver[];
}

/**
 * Admin/Ops-only editor for request management.
 */
export function RequestManagementPanel({
  reference,
  initialStatus,
  initialPriority,
  initialAssignee,
  initialDepartment,
  initialApprovers,
}: Props) {
  const router = useRouter();

  const [status, setStatus] = React.useState(initialStatus);
  const [priority, setPriority] = React.useState(initialPriority);
  const [assignee, setAssignee] =
    React.useState<Person | null>(initialAssignee);

  const [department, setDepartment] =
    React.useState(initialDepartment);

  const [approvers, setApprovers] =
    React.useState<Approver[]>(initialApprovers);

  const [selectedApprover, setSelectedApprover] =
    React.useState<Person | null>(null);

  const [saving, setSaving] = React.useState(false);
  const [saved, setSaved] = React.useState(false);
  const [error, setError] = React.useState<string | null>(null);

  const statusOptions = React.useMemo(() => {
    const list = [...WORKFLOW_STATUSES] as string[];

    if (!list.includes(initialStatus)) {
      list.unshift(initialStatus);
    }

    return list;
  }, [initialStatus]);

  const approverIds = React.useMemo(
    () => approvers.map((a) => a.id).sort(),
    [approvers]
  );

  const initialApproverIds = React.useMemo(
    () => initialApprovers.map((a) => a.id).sort(),
    [initialApprovers]
  );

  const dirty =
    status !== initialStatus ||
    priority !== initialPriority ||
    (assignee?.id ?? null) !==
    (initialAssignee?.id ?? null) ||
    department !== initialDepartment ||
    JSON.stringify(approverIds) !==
    JSON.stringify(initialApproverIds);

  async function handleSave() {
    setSaving(true);
    setError(null);
    setSaved(false);
    try {
      const res = await fetch(
        `/api/requests/${encodeURIComponent(reference)}`,
        {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            status,
            priority,

            assignedToId: assignee?.id ?? null,
            assignedToName: assignee?.name ?? null,

            assignedDepartment: department,

            approvers: approvers.map((a) => ({
              id: a.id,
              name: a.name,
              email: a.email,
              status: a.status,
              comment: a.comment,
            })),
          }),
        }
      );

      if (!res.ok) {
        const data = (await res
          .json()
          .catch(() => ({}))) as {
            error?: string;
          };

        throw new Error(
          data.error ?? "Failed to save changes"
        );
      }

      setSaved(true);
      router.refresh();
    } catch (e) {
      setError(
        e instanceof Error
          ? e.message
          : "Failed to save changes"
      );
    } finally {
      setSaving(false);
    }
  }

  return (
    <div className="space-y-5">
      <div className="rounded-lg border border-primary/15 bg-primary/5 px-3 py-2.5 text-xs leading-5 text-muted-foreground">
        Changes are applied together and recorded in the request activity timeline.
      </div>

      <div className="space-y-1.5">
        <Label htmlFor="mgmt-status">
          Status
        </Label>

        <Select
          id="mgmt-status"
          value={status}
          onChange={(e) => {
            setStatus(e.target.value);
            setSaved(false);
          }}
        >
          {statusOptions.map((s) => (
            <option
              key={s}
              value={s}
            >
              {s}
            </option>
          ))}
        </Select>
      </div>

      <div className="space-y-1.5">
        <Label htmlFor="mgmt-priority">
          Priority
        </Label>

        <Select
          id="mgmt-priority"
          value={priority}
          onChange={(e) => {
            setPriority(e.target.value);
            setSaved(false);
          }}
        >
          {PRIORITY_VALUES.map((p) => (
            <option
              key={p}
              value={p}
            >
              {p}
            </option>
          ))}
        </Select>
      </div>

      <div className="space-y-1.5">
        <Label htmlFor="mgmt-assignee">
          Assigned To
        </Label>

        <DirectoryPicker
          id="mgmt-assignee"
          value={assignee}
          onChange={(person) => {
            setAssignee(person);
            setSaved(false);
          }}
          emptyLabel="Unassigned"
        />
      </div>

      <div className="space-y-1.5">
        <Label htmlFor="mgmt-department">
          Assigned Department
        </Label>

        <Input
          id="mgmt-department"
          value={department}
          onChange={(e) => {
            setDepartment(e.target.value);
            setSaved(false);
          }}
          placeholder="e.g. ENTERPRISE-OPS-HELPDESK"
        />
      </div>

      <div className="space-y-3">
        <div className="flex items-center justify-between gap-3">
          <Label>Approvers</Label>
          <span className="text-xs text-muted-foreground">
            {approvers.length} configured
          </span>
        </div>

        <DirectoryPicker
          value={selectedApprover}
          onChange={setSelectedApprover}
          emptyLabel="Select approver"
        />

        <Button
          type="button"
          variant="outline"
          disabled={!selectedApprover}
          onClick={() => {
            if (!selectedApprover) return;

            const exists = approvers.some(
              (a) =>
                a.id === selectedApprover.id
            );

            if (exists) {
              setSelectedApprover(null);
              return;
            }

            setApprovers((current) => [
              ...current,
              {
                id: selectedApprover.id,
                name: selectedApprover.name,
                email: selectedApprover.email,
                department:
                  selectedApprover.department,
                status: "Active",
                comment: "",
              },
            ]);

            setSelectedApprover(null);
            setSaved(false);
          }}
        >
          Add Approver
        </Button>

        {approvers.length > 0 && (
          <div className="space-y-2">
            {approvers.map((a) => (
              <div
                key={a.id}
                className="flex items-center justify-between rounded-md border border-border p-3"
              >
                <div>
                  <div className="font-medium">
                    {a.name}
                  </div>

                  <div className="text-xs text-muted-foreground">
                    {a.email}
                  </div>

                  {a.department && (
                    <div className="text-xs text-muted-foreground">
                      {a.department}
                    </div>
                  )}
                </div>

                <Button
                  type="button"
                  size="sm"
                  variant="ghost"
                  onClick={() => {
                    setApprovers((current) =>
                      current.filter(
                        (x) => x.id !== a.id
                      )
                    );

                    setSaved(false);
                  }}
                >
                  Remove
                </Button>
              </div>
            ))}
          </div>
        )}
      </div>

      {error && (
        <p className="rounded-md bg-destructive/10 px-3 py-2 text-sm text-destructive">
          {error}
        </p>
      )}

      {saved && !dirty && (
        <p className="flex items-center gap-1.5 rounded-md bg-success/10 px-3 py-2 text-sm text-success">
          <Check className="h-4 w-4" />
          Changes saved successfully.
        </p>
      )}

      <Button
        onClick={handleSave}
        disabled={!dirty || saving}
        className="w-full"
      >
        {saving && (
          <Loader2 className="h-4 w-4 animate-spin" />
        )}
        {!saving && <Save className="h-4 w-4" />}
        {saving ? "Saving changes…" : "Save Changes"}
      </Button>
    </div>
  );
}
