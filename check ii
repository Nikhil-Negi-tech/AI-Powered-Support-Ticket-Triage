"use client";

import * as React from "react";
import { useRouter } from "next/navigation";
import { Controller, FormProvider, useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { z } from "zod";
import { CheckCircle2, UserPlus } from "lucide-react";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Button } from "@/components/ui/button";
import { Dialog } from "@/components/ui/dialog";
import { Checkbox } from "@/components/ui/checkbox";
import { FieldError, FieldHint } from "@/components/ui/field";
import { StatusBadge } from "@/components/ui/status-badges";
import { cn, formatDateTime, todayISO } from "@/lib/utils";
import type { AttachmentMeta } from "@/lib/types";
import { PageHeader } from "@/components/general-request/PageHeader";
import { StickyActionBar } from "@/components/general-request/StickyActionBar";
import { AttachmentsCard } from "@/components/general-request/AttachmentsCard";
import { ActivityTabs } from "@/components/general-request/ActivityTabs";
import { useCurrentUser } from "@/components/hooks/useCurrentUser";

const EMPLOYEE_TYPES = ["Consultant", "Full Time"] as const;
const ASSET_DISPATCH_OPTIONS = ["Yes", "No"] as const;
const ACCESS_OPTIONS = [
  "Domain ID",
  "Nice ID",
  "TMS ID",
  "Amadeus ID",
  "Sabre ID",
  "Farelogix",
  "OBE Access",
  "OAP Access",
  "One Terminal",
  "PK fare",
  "None",
] as const;

const DRAFT_STORAGE_KEY = "itsm.hr-onboarding.draft.v1";

const personSchema = z.object({
  id: z.string(),
  name: z.string(),
  email: z.string(),
  department: z.string(),
});

const onboardingSchema = z.object({
  name: z.string().trim().min(2, "Name is required"),
  dateOfJoining: z.string().trim().min(1, "Date of joining is required"),
  employeeType: z
    .string()
    .refine((value) => (EMPLOYEE_TYPES as readonly string[]).includes(value), {
      message: "Select an employee type",
    }),
  designation: z.string().trim().min(1, "Designation is required"),
  department: z.string().trim().min(1, "Department is required"),
  supervisorIndia: z.string().trim().min(1, "Supervisor (India) is required"),
  supervisorUS: z.string().trim().optional().default(""),
  proposedEmail: z
    .string()
    .trim()
    .min(1, "Proposed email ID is required"),
  defaultDLs: z.string().trim().optional().default(""),
  assetDispatch: z
    .string()
    .refine(
      (value) => (ASSET_DISPATCH_OPTIONS as readonly string[]).includes(value),
      { message: "Select an option" }
    ),
  accessRequired: z.array(z.string()).default([]),

  // Assignment and tracking
  assignedDepartment: z.string().default("Service Desk"),
  assignedTo: personSchema.nullable().default(null),
  followers: z.array(personSchema).default([]),
  tags: z.array(z.string()).max(10, "Maximum of 10 tags").default([]),
  approvers: z
    .array(
      z.object({
        id: z.string(),
        name: z.string(),
        email: z.string(),
        department: z.string(),
        status: z
          .enum(["Active", "Approved", "On Hold", "Cancelled"])
          .default("Active"),
        comment: z.string().max(500, "Comment is too long").default(""),
      })
    )
    .default([]),
});

type OnboardingValues = z.infer<typeof onboardingSchema>;

const defaultValues: OnboardingValues = {
  name: "",
  dateOfJoining: "",
  employeeType: "",
  designation: "",
  department: "",
  supervisorIndia: "",
  supervisorUS: "",
  proposedEmail: "",
  defaultDLs: "",
  assetDispatch: "",
  accessRequired: [],
  assignedDepartment: "Service Desk",
  assignedTo: null,
  followers: [],
  tags: [],
  approvers: [],
};

function generateReferenceId(): string {
  const n = Math.floor(Math.random() * 900000) + 100;
  return `ONB-${String(n).padStart(6, "0")}`;
}

function SummaryRow({
  label,
  children,
}: {
  label: string;
  children: React.ReactNode;
}) {
  return (
    <div className="flex items-center justify-between gap-4 py-1">
      <span className="text-sm text-muted-foreground">{label}</span>
      <span className="text-right text-sm font-medium text-foreground">
        {children}
      </span>
    </div>
  );
}

function RadioGroup({
  name,
  options,
  value,
  invalid,
  register,
}: {
  name: keyof OnboardingValues;
  options: readonly string[];
  value: string;
  invalid?: boolean;
  register: ReturnType<typeof useForm<OnboardingValues>>["register"];
}) {
  return (
    <div className="mt-1 grid gap-2 sm:grid-cols-2">
      {options.map((option) => {
        const checked = value === option;
        return (
          <label
            key={option}
            className={cn(
              "flex cursor-pointer items-center gap-3 rounded-md border px-4 py-3 text-sm shadow-sm transition-colors",
              checked
                ? "border-primary bg-primary/5 ring-1 ring-primary"
                : invalid
                ? "border-destructive bg-card"
                : "border-input bg-card hover:bg-secondary"
            )}
          >
            <input
              type="radio"
              value={option}
              className="h-4 w-4 accent-blue-600"
              {...register(name)}
            />
            <span className="font-medium text-foreground">{option}</span>
          </label>
        );
      })}
    </div>
  );
}

export function StaffOnboardingForm() {
  const router = useRouter();
  const createdAt = React.useMemo(() => new Date(), []);
  const { user: currentUser } = useCurrentUser();
  const draftStorageKey = currentUser
    ? `${DRAFT_STORAGE_KEY}.${currentUser.id}`
    : null;

  const methods = useForm<OnboardingValues>({
    resolver: zodResolver(onboardingSchema),
    defaultValues,
    mode: "onBlur",
  });
  const {
    register,
    handleSubmit,
    watch,
    reset,
    getValues,
    control,
    formState: { errors, isDirty },
  } = methods;

  const [isSubmitting, setIsSubmitting] = React.useState(false);
  const [showSuccess, setShowSuccess] = React.useState(false);
  const [showCancel, setShowCancel] = React.useState(false);
  const [draftSaved, setDraftSaved] = React.useState(false);
  const [referenceId, setReferenceId] = React.useState<string | null>(null);
  const [submittedTitle, setSubmittedTitle] = React.useState("");
  const [attachments, setAttachments] = React.useState<AttachmentMeta[]>([]);
  const [attachmentError, setAttachmentError] = React.useState<string | null>(
    null
  );

  const employeeType = watch("employeeType");
  const assetDispatch = watch("assetDispatch");

  React.useEffect(() => {
    if (!draftStorageKey) return;
    try {
      const raw = localStorage.getItem(draftStorageKey);
      if (!raw) return;
      const parsed = JSON.parse(raw);
      if (parsed && typeof parsed === "object") {
        reset({ ...defaultValues, ...parsed });
      }
    } catch {
      // Ignore malformed drafts.
    }
  }, [draftStorageKey, reset]);

  const saveDraft = () => {
    if (!draftStorageKey) return;
    try {
      localStorage.setItem(draftStorageKey, JSON.stringify(getValues()));
      setDraftSaved(true);
      setTimeout(() => setDraftSaved(false), 2500);
    } catch {
      // Storage may be unavailable; fail silently for this mock.
    }
  };

  const handleCancel = () => {
    if (isDirty || attachments.length > 0) {
      setShowCancel(true);
    } else {
      router.push("/");
    }
  };

  const onSubmit = async (values: OnboardingValues) => {
    if (attachments.length === 0) {
      setAttachmentError("Attach the required onboarding document.");
      requestAnimationFrame(() => {
        document
          .getElementById("onboarding-attachments")
          ?.scrollIntoView({ behavior: "smooth", block: "center" });
      });
      return;
    }

    setAttachmentError(null);
    setIsSubmitting(true);
    try {
      const res = await fetch("/api/requests", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          requestType: "hr-onboarding",
          attachmentIds: attachments
            .map((a) => a.attachmentId)
            .filter(
              (id): id is string =>
                typeof id === "string" && id.length > 0
            ),
          title: `Onboarding — ${values.name || "New Joiner"}`,
          description: `Onboarding request for ${values.name}${
            values.designation ? ` (${values.designation})` : ""
          }.`,
          priority: "Medium",
          department: values.department,
          assignedTo: values.assignedTo,
          assignedDepartment: values.assignedDepartment,
          approvers: values.approvers,
          followers: values.followers,
          payload: {
            newJoiner: values.name,
            dateOfJoining: values.dateOfJoining,
            employeeType: values.employeeType,
            designation: values.designation,
            department: values.department,
            supervisorIndia: values.supervisorIndia,
            supervisorUS: values.supervisorUS,
            proposedEmail: values.proposedEmail,
            defaultDLs: values.defaultDLs,
            assetDispatch: values.assetDispatch,
            accessRequired: Array.isArray(values.accessRequired)
              ? values.accessRequired.join(", ")
              : values.accessRequired,
          },
        }),
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error ?? "Submission failed");
      }
      setReferenceId(data.reference);
      setSubmittedTitle(`Onboarding — ${values.name || "New Joiner"}`);
      try {
        if (draftStorageKey) localStorage.removeItem(draftStorageKey);
      } catch {
        // Ignore storage errors.
      }
      setShowSuccess(true);
    } catch (error) {
      setAttachmentError(
        error instanceof Error
          ? error.message
          : "Submission failed. Please try again."
      );
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <FormProvider {...methods}>
      <main className="min-h-screen bg-background pb-4">
        <form
          onSubmit={handleSubmit(onSubmit)}
          noValidate
          className="mx-auto max-w-6xl px-4 py-6 sm:px-6"
        >
          <PageHeader
            formTitle="Staff Onboarding"
            formDescription="Request onboarding, access, and asset provisioning for a new joiner."
            icon={UserPlus}
            accent="from-violet-500 to-violet-700 text-white ring-white/20"
          />

          <div className="grid grid-cols-1 gap-6 lg:grid-cols-3">
            {/* Left column (wider) */}
            <div className="space-y-6 lg:col-span-2">
              <Card>
                <CardHeader>
                  <CardTitle>New Staff Onboarding Request</CardTitle>
                  <CardDescription>
                    When you submit this form, the owner will see your name and
                    email address. Fields marked{" "}
                    <span className="text-destructive">*</span> are required.
                  </CardDescription>
                </CardHeader>
                <CardContent className="space-y-5">
                  <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                      <Label htmlFor="name" required>
                        Name
                      </Label>
                      <Input
                        id="name"
                        placeholder="New joiner's full name"
                        invalid={!!errors.name}
                        {...register("name")}
                      />
                      <FieldError message={errors.name?.message} />
                    </div>

                    <div>
                      <Label htmlFor="dateOfJoining" required>
                        Date of Joining
                      </Label>
                      <Input
                        id="dateOfJoining"
                        type="date"
                        min={todayISO()}
                        invalid={!!errors.dateOfJoining}
                        {...register("dateOfJoining")}
                      />
                      <FieldError message={errors.dateOfJoining?.message} />
                    </div>
                  </div>

                  <div>
                    <Label required>Employee Type</Label>
                    <RadioGroup
                      name="employeeType"
                      options={EMPLOYEE_TYPES}
                      value={employeeType}
                      invalid={!!errors.employeeType}
                      register={register}
                    />
                    <FieldError message={errors.employeeType?.message} />
                  </div>

                  <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                      <Label htmlFor="designation" required>
                        Designation
                      </Label>
                      <Input
                        id="designation"
                        placeholder="e.g. Senior Engineer"
                        invalid={!!errors.designation}
                        {...register("designation")}
                      />
                      <FieldError message={errors.designation?.message} />
                    </div>

                    <div>
                      <Label htmlFor="department" required>
                        Department
                      </Label>
                      <Input
                        id="department"
                        placeholder="e.g. IT Engineering"
                        invalid={!!errors.department}
                        {...register("department")}
                      />
                      <FieldError message={errors.department?.message} />
                    </div>

                    <div>
                      <Label htmlFor="supervisorIndia" required>
                        Supervisor (India)
                      </Label>
                      <Input
                        id="supervisorIndia"
                        placeholder="Reporting supervisor in India"
                        invalid={!!errors.supervisorIndia}
                        {...register("supervisorIndia")}
                      />
                      <FieldError message={errors.supervisorIndia?.message} />
                    </div>

                    <div>
                      <Label htmlFor="supervisorUS">Supervisor (US)</Label>
                      <Input
                        id="supervisorUS"
                        placeholder="Reporting supervisor in US"
                        invalid={!!errors.supervisorUS}
                        {...register("supervisorUS")}
                      />
                      <FieldError message={errors.supervisorUS?.message} />
                    </div>

                    <div>
                      <Label htmlFor="proposedEmail" required>
                        New Joiner Proposed Email ID
                      </Label>
                      <Input
                        id="proposedEmail"
                        placeholder="proposed.name@fareportal.com"
                        invalid={!!errors.proposedEmail}
                        {...register("proposedEmail")}
                      />
                      <FieldError message={errors.proposedEmail?.message} />
                    </div>

                    <div>
                      <Label htmlFor="defaultDLs">Default DLs Email ID</Label>
                      <Input
                        id="defaultDLs"
                        placeholder="e.g. Team India, HOD India"
                        invalid={!!errors.defaultDLs}
                        {...register("defaultDLs")}
                      />
                      <FieldHint>
                        Distribution lists the new joiner should be added to.
                      </FieldHint>
                      <FieldError message={errors.defaultDLs?.message} />
                    </div>
                  </div>

                  <div>
                    <Label required>If asset needs to be dispatched</Label>
                    <RadioGroup
                      name="assetDispatch"
                      options={ASSET_DISPATCH_OPTIONS}
                      value={assetDispatch}
                      invalid={!!errors.assetDispatch}
                      register={register}
                    />
                    <FieldError message={errors.assetDispatch?.message} />
                  </div>

                  <div>
                    <Label>Access Required to be given</Label>
                    <Controller
                      control={control}
                      name="accessRequired"
                      render={({ field }) => {
                        const selected = field.value ?? [];
                        const toggle = (option: string) => {
                          if (option === "None") {
                            field.onChange(
                              selected.includes("None") ? [] : ["None"]
                            );
                            return;
                          }
                          const withoutNone = selected.filter(
                            (item) => item !== "None"
                          );
                          field.onChange(
                            withoutNone.includes(option)
                              ? withoutNone.filter((item) => item !== option)
                              : [...withoutNone, option]
                          );
                        };
                        return (
                          <div className="mt-1 grid gap-2 sm:grid-cols-2">
                            {ACCESS_OPTIONS.map((option) => {
                              const checked = selected.includes(option);
                              return (
                                <label
                                  key={option}
                                  className={cn(
                                    "flex cursor-pointer items-center gap-3 rounded-md border px-4 py-2.5 text-sm shadow-sm transition-colors",
                                    checked
                                      ? "border-primary bg-primary/5"
                                      : "border-input bg-card hover:bg-secondary"
                                  )}
                                >
                                  <Checkbox
                                    checked={checked}
                                    onCheckedChange={() => toggle(option)}
                                  />
                                  <span className="font-medium text-foreground">
                                    {option}
                                  </span>
                                </label>
                              );
                            })}
                          </div>
                        );
                      }}
                    />
                  </div>
                </CardContent>
              </Card>

              <div id="onboarding-attachments" className="space-y-2">
                <div>
                  <Label required>Attachment</Label>
                  <FieldHint>
                    Upload the supporting onboarding document (Word, Excel, PPT,
                    PDF, image, video, or audio).
                  </FieldHint>
                </div>
                <AttachmentsCard
                  files={attachments}
                  onChange={(next) => {
                    setAttachments(next);
                    if (next.length > 0) setAttachmentError(null);
                  }}
                />
                <FieldError message={attachmentError ?? undefined} />
              </div>

              <ActivityTabs />
            </div>

            {/* Right column */}
            <div className="space-y-6 lg:col-span-1">
              <Card>
                <CardHeader>
                  <CardTitle>Request Information</CardTitle>
                </CardHeader>
                <CardContent className="space-y-4">
                  <SummaryRow label="Status">
                    <StatusBadge status="Draft" />
                  </SummaryRow>

                  <div className="space-y-1 border-t border-border pt-4">
                    <SummaryRow label="Request Type">
                      Staff Onboarding
                    </SummaryRow>
                    <SummaryRow label="Created Date">
                      {formatDateTime(createdAt)}
                    </SummaryRow>
                    <SummaryRow label="Reference ID">
                      {referenceId ? (
                        <span className="font-mono text-primary">
                          {referenceId}
                        </span>
                      ) : (
                        <span className="italic text-muted-foreground">
                          Generated after submission
                        </span>
                      )}
                    </SummaryRow>
                  </div>

                  <div className="space-y-1 border-t border-border pt-4">
                    <SummaryRow label="Employee Type">
                      {employeeType || (
                        <span className="italic text-muted-foreground">
                          Not selected
                        </span>
                      )}
                    </SummaryRow>
                    <SummaryRow label="Asset Dispatch">
                      {assetDispatch || (
                        <span className="italic text-muted-foreground">
                          Not selected
                        </span>
                      )}
                    </SummaryRow>
                  </div>
                </CardContent>
              </Card>
            </div>
          </div>

          <StickyActionBar
            onCancel={handleCancel}
            onSaveDraft={saveDraft}
            isSubmitting={isSubmitting}
            draftSaved={draftSaved}
          />
        </form>

        {/* Cancel confirmation */}
        <Dialog
          open={showCancel}
          onClose={() => setShowCancel(false)}
          title="Discard this request?"
          description="You have unsaved changes. If you leave now, your changes will be lost."
          footer={
            <>
              <Button variant="outline" onClick={() => setShowCancel(false)}>
                Keep Editing
              </Button>
              <Button variant="destructive" onClick={() => router.push("/")}>
                Discard Changes
              </Button>
            </>
          }
        />

        {/* Success message */}
        <Dialog
          open={showSuccess}
          onClose={() => setShowSuccess(false)}
          title="Request submitted"
          hideClose
          footer={
            <>
              <Button
                variant="outline"
                onClick={() => {
                  setShowSuccess(false);
                  reset(defaultValues);
                  setReferenceId(null);
                  setAttachments([]);
                  setAttachmentError(null);
                }}
              >
                Create Another
              </Button>
              <Button
                variant="success"
                onClick={() =>
                  router.push(
                    `/requests/${encodeURIComponent(referenceId ?? "")}`
                  )
                }
              >
                View Request
              </Button>
            </>
          }
        >
          <div className="space-y-4">
            <div className="flex flex-col items-center gap-3 text-center">
              <CheckCircle2 className="h-12 w-12 text-success" />
              <h3 className="text-lg font-semibold">
                Request Submitted Successfully
              </h3>
              <p className="text-sm text-muted-foreground">
                Your request has been created and is now available for tracking.
              </p>
            </div>
            <div className="rounded-lg border border-border bg-muted/40 p-4">
              <div className="grid gap-2 text-sm">
                <div>
                  <span className="font-medium">Request ID:</span>{" "}
                  {referenceId}
                </div>
                <div>
                  <span className="font-medium">Title:</span> {submittedTitle}
                </div>
                <div>
                  <span className="font-medium">Status:</span> New
                </div>
                <div>
                  <span className="font-medium">Created:</span>{" "}
                  {new Date().toLocaleString()}
                </div>
              </div>
            </div>
          </div>
        </Dialog>
      </main>
    </FormProvider>
  );
}
