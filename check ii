"use client";

import * as React from "react";
import { Controller, useFormContext } from "react-hook-form";

import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";

import { Label } from "@/components/ui/label";
import { Select } from "@/components/ui/select";
import { TagInput } from "./TagInput";
import {
  DirectoryPicker,
  DirectoryMultiPicker,
} from "./DirectoryPickers";
import { ApproverPanel } from "./ApproverPanel";
import { TAG_SUGGESTIONS } from "@/lib/mock-data";
import type { GeneralRequestFormValues } from "@/lib/schema";

/**
 * Departments sourced from synced Entra ID users.
 */
function useDepartments() {
  const [departments, setDepartments] = React.useState<string[]>([]);

  React.useEffect(() => {
    let active = true;

    fetch("/api/departments")
      .then((res) =>
        res.ok ? res.json() : { departments: [] }
      )
      .then((data: { departments: string[] }) => {
        if (active) {
          setDepartments(data.departments ?? []);
        }
      })
      .catch(() => {
        if (active) {
          setDepartments([]);
        }
      });

    return () => {
      active = false;
    };
  }, []);

  return departments;
}

export function AssignmentTrackingCard() {
  const { control, watch, setValue } =
    useFormContext<GeneralRequestFormValues>();

  const departments = useDepartments();
  const assignedDepartment = watch("assignedDepartment");

  return (
    <>
      <Card>
        <CardHeader>
          <CardTitle>Assignment and Tracking</CardTitle>
        </CardHeader>

        <CardContent className="space-y-5">
          {/* Assigned Department — sourced from Entra ID */}
          <div>
            <Label htmlFor="assignedDepartment">
              Assigned Department
            </Label>

            <Controller
              control={control}
              name="assignedDepartment"
              render={({ field }) => (
                <Select
                  id="assignedDepartment"
                  value={field.value ?? ""}
                  onChange={(e) => {
                    field.onChange(e.target.value);

                    // Reset assignee when the department changes.
                    setValue("assignedTo", null, {
                      shouldDirty: true,
                    });
                  }}
                >
                  <option value="">
                    Select a department
                  </option>

                  {departments.map((d) => (
                    <option key={d} value={d}>
                      {d}
                    </option>
                  ))}
                </Select>
              )}
            />
          </div>

          {/* Assigned To — restricted to the selected department */}
          <div>
            <Label htmlFor="assignedTo">
              Assigned To
            </Label>

            <Controller
              control={control}
              name="assignedTo"
              render={({ field }) => (
                <DirectoryPicker
                  id="assignedTo"
                  value={field.value ?? null}
                  onChange={field.onChange}
                  department={
                    assignedDepartment || undefined
                  }
                  disabled={!assignedDepartment}
                  disabledHint="Select a department first"
                  emptyLabel="Unassigned"
                  placeholder="Search people in this department..."
                />
              )}
            />
          </div>

          {/* Followers — any organization user */}
          <div>
            <Label htmlFor="followers">
              Followers
            </Label>

            <Controller
              control={control}
              name="followers"
              render={({ field }) => (
                <DirectoryMultiPicker
                  id="followers"
                  value={field.value ?? []}
                  onChange={field.onChange}
                  placeholder="Add followers..."
                />
              )}
            />
          </div>

          {/* Tags */}
          <div>
            <Label htmlFor="tags">
              Tags
            </Label>

            <Controller
              control={control}
              name="tags"
              render={({ field }) => (
                <TagInput
                  id="tags"
                  value={field.value ?? []}
                  onChange={field.onChange}
                  suggestions={TAG_SUGGESTIONS}
                />
              )}
            />
          </div>
        </CardContent>
      </Card>

      <ApproverPanel />
    </>
  );
}
