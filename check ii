import type { Metadata } from "next";
import { redirect } from "next/navigation";

import { AdministrationCenter } from "@/components/admin/AdministrationCenter";

import { getRequestAnalytics } from "@/lib/services/requests";
import { getSessionUser, isAdminEmail } from "@/lib/session";

export const metadata: Metadata = {
  title: "Admin | ITSM Service Portal",
  description: "Administration area for managing the service portal.",
};

export default async function AdminPage() {
  const user = await getSessionUser();
  if (!user) redirect("/login");
  if (!(await isAdminEmail(user.email))) redirect("/");

  const a = await getRequestAnalytics();

  return <AdministrationCenter analytics={a} />;
}
