"use client";

import { Controller, useFormContext } from "react-hook-form";
import { ShieldCheck, X } from "lucide-react";

import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";

import { Label } from "@/components/ui/label";
import { Select } from "@/components/ui/select";
import { Textarea } from "@/components/ui/textarea";
import { UserAvatar } from "@/components/ui/user-avatar";

import {
  DirectoryMultiPicker,
  userPhotoUrl,
} from "./DirectoryPickers";

import {
  APPROVER_STATUSES,
  type Approver,
  type ApproverStatus,
} from "@/lib/types";

import type { GeneralRequestFormValues } from "@/lib/schema";
import { cn } from "@/lib/utils";

const STATUS_DOT: Record<ApproverStatus, string> = {
  Active: "bg-blue-500",
  Approved: "bg-green-500",
  "On Hold": "bg-orange-500",
  Cancelled: "bg-slate-400",
};

export function ApproverPanel() {
  const { control } =
    useFormContext<GeneralRequestFormValues>();

  return (
    <Card>
      <CardHeader>
        <CardTitle className="flex items-center gap-2">
          <ShieldCheck className="h-4 w-4 text-primary" />
          Approvers Panel
        </CardTitle>
      </CardHeader>

      <CardContent className="space-y-4">
        <Controller
          control={control}
          name="approvers"
          render={({ field }) => {
            const approvers =
              (field.value ?? []) as Approver[];

            const addPeople = (
              people: {
                id: string;
                name: string;
                email: string;
                department: string;
              }[]
            ) => {
              const existing = new Set(
                approvers.map((a) => a.id)
              );

              const additions: Approver[] = people
                .filter((p) => !existing.has(p.id))
                .map((p) => ({
                  ...p,
                  status: "Active" as ApproverStatus,
                  comment: "",
                }));

              field.onChange([
                ...approvers,
                ...additions,
              ]);
            };

            const patch = (
              id: string,
              changes: Partial<Approver>
            ) => {
              field.onChange(
                approvers.map((a) =>
                  a.id === id
                    ? { ...a, ...changes }
                    : a
                )
              );
            };

            const remove = (id: string) => {
              field.onChange(
                approvers.filter((a) => a.id !== id)
              );
            };

            return (
              <>
                <DirectoryMultiPicker
                  id="approvers"
                  value={[]}
                  onChange={addPeople}
                  placeholder="Search approvers by email..."
                />

                {approvers.length === 0 ? (
                  <p className="rounded-md border border-dashed border-border px-3 py-4 text-center text-sm text-muted-foreground">
                    No approvers added yet.
                  </p>
                ) : (
                  <ul className="space-y-3">
                    {approvers.map((approver) => (
                      <li
                        key={approver.id}
                        className="rounded-lg border border-border p-3"
                      >
                        <div className="flex items-start gap-2.5">
                          <UserAvatar
                            name={approver.name}
                            src={userPhotoUrl(
                              approver.id
                            )}
                            size="md"
                          />

                          <div className="min-w-0 flex-1">
                            <div className="truncate text-sm font-medium text-foreground">
                              {approver.name}
                            </div>

                            <div className="truncate text-xs text-muted-foreground">
                              {approver.email}
                            </div>
                          </div>

                          <button
                            type="button"
                            aria-label={`Remove ${approver.name}`}
                            onClick={() =>
                              remove(approver.id)
                            }
                            className="rounded p-1 text-muted-foreground hover:bg-secondary hover:text-foreground"
                          >
                            <X className="h-3.5 w-3.5" />
                          </button>
                        </div>

                        <div className="mt-3 grid gap-3">
                          <div>
                            <Label
                              htmlFor={`approver-status-${approver.id}`}
                              className="text-xs"
                            >
                              Status
                            </Label>

                            <div className="relative">
                              <span
                                className={cn(
                                  "pointer-events-none absolute left-3 top-1/2 h-2 w-2 -translate-y-1/2 rounded-full",
                                  STATUS_DOT[
                                    approver.status
                                  ]
                                )}
                              />

                              <Select
                                id={`approver-status-${approver.id}`}
                                value={approver.status}
                                onChange={(e) =>
                                  patch(
                                    approver.id,
                                    {
                                      status:
                                        e.target
                                          .value as ApproverStatus,
                                    }
                                  )
                                }
                                className="pl-7"
                              >
                                {APPROVER_STATUSES.map(
                                  (status) => (
                                    <option
                                      key={status}
                                      value={status}
                                    >
                                      {status}
                                    </option>
                                  )
                                )}
                              </Select>
                            </div>
                          </div>

                          <div>
                            <Label
                              htmlFor={`approver-comment-${approver.id}`}
                              className="text-xs"
                            >
                              Comment
                            </Label>

                            <Textarea
                              id={`approver-comment-${approver.id}`}
                              rows={2}
                              maxLength={500}
                              placeholder="Add a short review note..."
                              value={approver.comment ?? ""}
                              onChange={(e) =>
                                patch(approver.id, {
                                  comment:
                                    e.target.value,
                                })
                              }
                            />
                          </div>
                        </div>
                      </li>
                    ))}
                  </ul>
                )}
              </>
            );
          }}
        />
      </CardContent>
    </Card>
  );
}
