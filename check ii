import { NextResponse } from "next/server";
import { getSessionUser, isAdminEmail } from "@/lib/session";
import { q } from "@/lib/db/client";

export const dynamic = "force-dynamic";

function csv(value: unknown): string {
  const text = String(value ?? "");
  return /[",\r\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
}

export async function GET() {
  const user = await getSessionUser();
  if (!user || !(await isAdminEmail(user.email))) return NextResponse.json({ error: "Forbidden" }, { status: 403 });
  const rows = await q<{ reference: string; request_type: string; title: string; status: string; priority: string; department: string; requester_name: string; assigned_to_name: string | null; created_at: string }>(
    `SELECT reference, request_type, title, status, priority, department, requester_name, assigned_to_name, created_at
       FROM service_requests WHERE deleted_at IS NULL ORDER BY created_at DESC`
  );
  const header = ["Reference", "Request Type", "Title", "Status", "Priority", "Department", "Requester", "Assignee", "Created"].join(",");
  const body = rows.map((row) => [row.reference, row.request_type, row.title, row.status, row.priority, row.department, row.requester_name, row.assigned_to_name, row.created_at].map(csv).join(","));
  return new NextResponse([header, ...body].join("\r\n"), { headers: { "Content-Type": "text/csv; charset=utf-8", "Content-Disposition": `attachment; filename="itsm-requests-${new Date().toISOString().slice(0, 10)}.csv"` } });
}
