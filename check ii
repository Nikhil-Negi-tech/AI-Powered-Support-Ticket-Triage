import { NextResponse } from "next/server";
import { q, withTransaction } from "@/lib/db/client";
import { getSessionUser, isAdminEmail } from "@/lib/session";
import { writeAdminAudit } from "@/lib/services/administration";

export const dynamic = "force-dynamic";

async function admin() { const user = await getSessionUser(); return user && (await isAdminEmail(user.email)) ? user : null; }

export async function GET(request: Request) {
  if (!(await admin())) return NextResponse.json({ error: "Forbidden" }, { status: 403 });
  const params = new URL(request.url).searchParams;
  const query = `%${(params.get("q") ?? "").trim()}%`;
  const rows = await q(`SELECT u.id, u.display_name, u.email, u.department, u.job_title, u.account_status, u.manager_name, u.created_at, u.updated_at, COALESCE(json_agg(json_build_object('role', r.role)) FILTER (WHERE r.role IS NOT NULL), '[]') AS roles FROM organization_users u LEFT JOIN user_roles r ON lower(r.user_email) = lower(u.email) WHERE ($1 = '%%' OR u.display_name ILIKE $1 OR u.email ILIKE $1 OR u.department ILIKE $1) GROUP BY u.id ORDER BY u.display_name LIMIT 100`, [query]);
  return NextResponse.json({ users: rows });
}

export async function PATCH(request: Request) {
  const actor = await admin();
  if (!actor) return NextResponse.json({ error: "Forbidden" }, { status: 403 });
  let body: Record<string, unknown>; try { body = await request.json(); } catch { return NextResponse.json({ error: "Invalid body" }, { status: 400 }); }
  if (typeof body.userId !== "string") return NextResponse.json({ error: "userId is required" }, { status: 400 });
  if (body.status !== undefined && !["active", "inactive"].includes(String(body.status))) return NextResponse.json({ error: "Invalid status" }, { status: 400 });
  if (body.role !== undefined && !["User", "Approver", "Manager", "Admin", "Super Admin"].includes(String(body.role))) return NextResponse.json({ error: "Invalid role" }, { status: 400 });
  await withTransaction(async (client) => {
    const before = await client.query<Record<string, unknown>>(`SELECT * FROM organization_users WHERE id = $1 FOR UPDATE`, [body.userId]);
    if (!before.rows[0]) throw new Error("User not found");
    if (body.status !== undefined) await client.query(`UPDATE organization_users SET account_status = $2, updated_at = now() WHERE id = $1`, [body.userId, body.status]);
    if (body.department !== undefined) await client.query(`UPDATE organization_users SET department = $2, updated_at = now() WHERE id = $1`, [body.userId, String(body.department)]);
    if (body.role !== undefined) await client.query(`INSERT INTO user_roles (user_email, role, granted_by) VALUES ((SELECT email FROM organization_users WHERE id = $1), $2, $3) ON CONFLICT (user_email, role) DO NOTHING`, [body.userId, body.role, actor.email]);
    await writeAdminAudit(client, { actor: { id: actor.id, email: actor.email, name: actor.displayName }, action: "updated", resourceType: "user", resourceId: body.userId, oldValue: before.rows[0], newValue: { status: body.status, department: body.department, role: body.role } });
  });
  return NextResponse.json({ success: true, userId: body.userId });
}
